[Unit]
Description=Monitor de recursos da VPS ApoiarCred
Wants=network-online.target
After=network-online.target
[Service]
User=apoiarcred
WorkingDirectory=/opt/apoiarcred/vps
EnvironmentFile=/opt/apoiarcred/.env
ExecStart=/opt/apoiarcred/.venv/bin/python -u monitor.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=64M
CPUQuota=10%
[Install]
WantedBy=multi-user.target
